# ==============================================================================
# Nowshera Family Clinic - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# Accessible client-side via import.meta.env
# ------------------------------------------------------------------------------

# Public Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anonymous Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend FastAPI URL for API requests
VITE_API_BASE_URL=http://localhost:8000/api/v1


# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI / Python)
# Server-side secrets - NEVER expose to the browser
# ------------------------------------------------------------------------------

# FastAPI Server Port
PORT=8000

# Supabase API URL (same as project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Public Key
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Required for admin/elevated operations, bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (From Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Allowed CORS Origins (comma-separated or list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
